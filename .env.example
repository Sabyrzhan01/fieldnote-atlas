# Application server configuration
PORT=8000
HOST=0.0.0.0

# PostgreSQL connection string (used by FastAPI, SQLAlchemy, and Alembic)
DATABASE_URL=postgresql+psycopg://fieldnote:fieldnote@localhost:5432/fieldnote_atlas

# Docker Compose PostgreSQL service credentials
POSTGRES_USER=fieldnote
POSTGRES_PASSWORD=fieldnote
POSTGRES_DB=fieldnote_atlas

# Optional: Enable /api/test/reset endpoint in E2E test environments only (0 in production)
ENABLE_TEST_RESET=0

# Telemetry is opt-in outside deploy/compose.yml.
APP_ENV=local
APP_VERSION=local
OTEL_EXPORTER_OTLP_ENDPOINT=

# Observability Compose, supplied in a separate private env file.
GRAFANA_ADMIN_PASSWORD=
ALERT_TOKEN_FILE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Deployment host environment files (one per environment).
# APP_PORT=8000                 # production uses 8001
# DB_PASSWORD=                  # generate with openssl rand -hex 32
# APP_IMAGE and APP_VERSION are set by deploy/release.sh.
