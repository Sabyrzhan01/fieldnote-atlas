# Application server configuration
PORT=8000
HOST=0.0.0.0

# PostgreSQL connection string (used by FastAPI, SQLAlchemy, and Alembic)
DATABASE_URL=postgresql+psycopg://fieldnote:fieldnote@localhost:5432/fieldnote_atlas

# Docker Compose PostgreSQL service credentials
POSTGRES_USER=fieldnote
POSTGRES_PASSWORD=fieldnote
POSTGRES_DB=fieldnote_atlas

# Optional: Enable /api/test/reset endpoint in E2E test environments only (0 in production)
ENABLE_TEST_RESET=0
