{
  "name": "fieldnote-atlas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 server.py",
    "test": "python3 -m unittest discover -s backend/tests -v",
    "test:unit": "python3 -m unittest discover -s backend/tests -v",
    "test:e2e": "pytest tests/e2e -v",
    "test:all": "npm run test:unit && npm run test:e2e",
    "build": "python3 -m compileall -q backend server.py",
    "docker:build": "docker build -t fieldnote-atlas .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "python3 scripts/migrate_sqlite_to_postgres.py"
  }
}
